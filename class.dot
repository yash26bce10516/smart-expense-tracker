digraph C {
  rankdir=TB; fontname="Helvetica"; nodesep=0.5; ranksep=0.7;
  node [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#FFFFFF"];
  edge [fontname="Helvetica", fontsize=9];
  Database [label="{Database|+ path: str|+ session(): contextmanager}"];
  App [label="{App (cli.py)|- user: User|- auth, expenses, budgets, analytics|+ run()\l- _add() _view() _edit() _delete()\l- _report() _trend() _export() _import()\l}", fillcolor="#EAF2FB"];
  AuthService [label="{AuthService|+ db: Database|+ register(username, password): User\l+ login(username, password): User\l}", fillcolor="#EAF7EA"];
  ExpenseService [label="{ExpenseService|+ db: Database|+ add(...): Expense\l+ get(user_id, id): Expense\l+ list(user_id, month, category, keyword)\l+ update(user_id, id, **fields)\l+ delete(user_id, id)\l}", fillcolor="#EAF7EA"];
  BudgetService [label="{BudgetService|+ db: Database|+ set_budget(user_id, category, limit)\l+ remove_budget(user_id, category)\l+ status(user_id, month)\l+ alerts(user_id, month)\l}", fillcolor="#EAF7EA"];
  Analytics [label="{Analytics|+ db: Database|+ monthly_summary(user_id, month)\l+ category_breakdown(user_id, month)\l+ top_expenses(user_id, month, n)\l+ monthly_trend(user_id, months)\l+ forecast_month_end(user_id, month)\l}", fillcolor="#EAF7EA"];
  User [label="{User (dataclass)|+ id: int|+ username: str}", fillcolor="#FFF6E5"];
  Expense [label="{Expense (dataclass)|+ id, user_id: int|+ amount: float|+ category, description, date: str}", fillcolor="#FFF6E5"];
  Budget [label="{Budget (dataclass)|+ id, user_id: int|+ category: str|+ monthly_limit: float}", fillcolor="#FFF6E5"];
  BudgetStatus [label="{BudgetStatus (dataclass)|+ category: str|+ limit, spent, percent: float|+ level: str}", fillcolor="#FFF6E5"];
  TrackerError [label="{TrackerError|(base exception)}", fillcolor="#F8E0DD"];
  ValidationError [label="{ValidationError}", fillcolor="#F8E0DD"];
  AuthError [label="{AuthError}", fillcolor="#F8E0DD"];
  NotFoundError [label="{NotFoundError}", fillcolor="#F8E0DD"];

  App -> AuthService [arrowhead=vee, label="uses"]; App -> ExpenseService [arrowhead=vee]; App -> BudgetService [arrowhead=vee]; App -> Analytics [arrowhead=vee];
  AuthService -> Database [arrowhead=odiamond, label="has-a"]; ExpenseService -> Database [arrowhead=odiamond]; BudgetService -> Database [arrowhead=odiamond]; Analytics -> Database [arrowhead=odiamond];
  AuthService -> User [style=dashed, arrowhead=vee, label="creates"]; ExpenseService -> Expense [style=dashed, arrowhead=vee]; BudgetService -> Budget [style=dashed, arrowhead=vee]; BudgetService -> BudgetStatus [style=dashed, arrowhead=vee];
  ValidationError -> TrackerError [arrowhead=empty]; AuthError -> TrackerError [arrowhead=empty]; NotFoundError -> TrackerError [arrowhead=empty];
}
