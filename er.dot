digraph ER {
  rankdir=LR; fontname="Helvetica"; nodesep=0.8; ranksep=1.6;
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=11];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF2FB">
    <TR><TD BGCOLOR="#7FA7D9"><B>users</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> INTEGER PK</TD></TR>
    <TR><TD ALIGN="LEFT">username TEXT UNIQUE</TD></TR>
    <TR><TD ALIGN="LEFT">password_hash TEXT</TD></TR>
    <TR><TD ALIGN="LEFT">salt TEXT</TD></TR>
    <TR><TD ALIGN="LEFT">created_at TEXT</TD></TR></TABLE>>];
  expenses [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF7EA">
    <TR><TD BGCOLOR="#7DBB7D"><B>expenses</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> INTEGER PK</TD></TR>
    <TR><TD ALIGN="LEFT">user_id INTEGER FK</TD></TR>
    <TR><TD ALIGN="LEFT">amount REAL (&gt; 0)</TD></TR>
    <TR><TD ALIGN="LEFT">category TEXT</TD></TR>
    <TR><TD ALIGN="LEFT">description TEXT</TD></TR>
    <TR><TD ALIGN="LEFT">date TEXT (YYYY-MM-DD)</TD></TR>
    <TR><TD ALIGN="LEFT">created_at TEXT</TD></TR></TABLE>>];
  budgets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF6E5">
    <TR><TD BGCOLOR="#E0B458"><B>budgets</B></TD></TR>
    <TR><TD ALIGN="LEFT"><U>id</U> INTEGER PK</TD></TR>
    <TR><TD ALIGN="LEFT">user_id INTEGER FK</TD></TR>
    <TR><TD ALIGN="LEFT">category TEXT</TD></TR>
    <TR><TD ALIGN="LEFT">monthly_limit REAL (&gt; 0)</TD></TR>
    <TR><TD ALIGN="LEFT">UNIQUE(user_id, category)</TD></TR></TABLE>>];
  users -> expenses [label="1 : N  records", arrowhead=crow, arrowtail=tee, dir=both];
  users -> budgets [label="1 : N  sets", arrowhead=crow, arrowtail=tee, dir=both];
}
